{
  "name": "dns-switch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "package:win": "npm run build && electron-packager . DNS-Switch --platform=win32 --arch=x64 --out=release --overwrite --ignore=tests --ignore=release --ignore=playwright-report --ignore=test-results --ignore=macos",
    "package:win:e2e": "npm run build && electron-packager . DNS-Switch --platform=win32 --arch=x64 --out=release --overwrite --ignore=tests --ignore=release --ignore=playwright-report --ignore=test-results --ignore=macos"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2",
    "svelte": "^5.0.0",
    "svelte-check": "^3.8.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}
